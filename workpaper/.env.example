# Optional for local development; required on Vercel. Server only.
# Apply all four SQL migrations in supabase/migrations/ in filename order.
# Without credentials, local development uses ignored .data/ files.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative, used only when SUPABASE_SECRET_KEY is empty:
SUPABASE_SERVICE_ROLE_KEY=

# Required on Vercel: a stable random secret of at least 32 bytes.
# Generate one with: openssl rand -hex 32
# Locally an ignored .data/session-secret is created automatically.
WORKSPACE_SESSION_SECRET=
